# Domain for HTTPS (Caddy gets a Let's Encrypt certificate). Without a real
# domain: <ip-with-dashes>.sslip.io, e.g. 1-2-3-4.sslip.io
DOMAIN=tasks.example.com

# Voice → text on the server (optional), any OpenAI-compatible endpoint
# (https only, http allowed for localhost/private hosts). Recordings without
# text are sent there — i.e. to that provider.
TRANSCRIBE_KEY=
# At most this many minutes of audio per day go to transcription (0 = no limit).
#TRANSCRIBE_DAILY_MINUTES=120
#TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
#TRANSCRIBE_MODEL=whisper-1
#TRANSCRIBE_LANG=ru

# Total size of stored recordings, MB (0 = no limit). When full, new
# recordings are refused (tasks with text still work).
#AUDIO_MAX_MB=2048
